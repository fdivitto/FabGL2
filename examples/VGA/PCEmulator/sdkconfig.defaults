# FabGL2 example - ESP-IDF configuration defaults
CONFIG_IDF_TARGET="esp32"

# Flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Run app_main() on CPU1 with a larger stack (FabGL video tasks are pinned to the core not used by WiFi)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# the CPU-intensive tasks of this example can keep the idle tasks from running
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# lwIP task on the WiFi core: unpinned it can run on CPU1 and delay the VGA interrupt (flickering while downloading)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# PS/2 controller runs on ULP FSM coprocessor
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_FSM=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# PSRAM: mapped into the address space only (the app accesses it directly at SOC_EXTRAM_DATA_LOW).
# The compiler workaround for ESP32 rev.1 PSRAM bug is disabled because it slows down the CPU too much.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MEMMAP=y
CONFIG_SPIRAM_CACHE_WORKAROUND=n
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# FAT fast seek (in-memory cluster map) for disk images, opened read-only for reads (see Machine::diskRead())
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=128

# HTTPS downloads: the frame buffer of the user interface leaves little RAM, so reduce the memory used by TLS and
# WiFi (without these, the minimum free heap during a download was ~3 KB)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# fabgl::HTTPRequest keeps a TLS record buffer reserved (16 KB records with fragmented heap)
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
